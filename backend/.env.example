PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Controlled single-booking cutover. Production must set this explicitly and uses V2.
# Development may temporarily set 1 only for V1 compatibility verification.
BOOKING_FLOW_VERSION=2

# Resend API; EMAIL_FROM is only the sender email address, display name is set by backend.
# Development may use an allowed Resend test sender; production requires a verified domain.
RESEND_API_KEY=
EMAIL_FROM=

# Cloudinary FacilityImage only; public image delivery. Never commit real keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Điền riêng tại .env; không commit connection string thật.
DATABASE_URL=
DATABASE_CA_PATH=certs/supabase-ca.crt
# Tùy chọn cho Prisma CLI nếu runtime dùng transaction pooler sau này.
# DIRECT_URL=

# Demo seed chỉ chạy development sau `npm run seed:demo -- --check`.
# Không commit mật khẩu demo. Fingerprint phải khớp đúng output check-only đã review.
DEMO_SEED_CONFIRM=
DEMO_SEED_TARGET_FINGERPRINT=
DEMO_OWNER_PASSWORD=
DEMO_CUSTOMER_PASSWORD=
DEMO_ADMIN_PASSWORD=

// Baseline v1; chỉ mô tả schema, chưa có migration hoặc thay đổi database.
// Status giữ VARCHAR + CHECK theo DATABASE.md; CHECK chưa được thực thi.
// Xem docs/plans/PRISMA_SCHEMA_REVIEW.md cho manual constraints và TODO Report.
// created_at do caller cấp bằng DB time; updated_at dùng @updatedAt.
// Không thêm default status/giá/TTL. FK Restrict khi xóa hoặc đổi ID.
generator client {
  provider        = "prisma-client-js"
  engineType      = "client"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// Role nền CUSTOMER/ADMIN; OwnerProfile bổ sung Owner capability. Status ACTIVE/LOCKED; CHECK ở migration sau.
model User {
  id BigInt @id @default(autoincrement()) @db.BigInt

  email            String    @db.VarChar(254)
  email_normalized String    @unique @db.VarChar(254)
  password_hash    String?   @db.VarChar(255)
  google_subject   String?   @unique @db.VarChar(255)
  full_name        String    @db.VarChar(150)
  phone            String?   @db.VarChar(30)
  avatar_path      String?   @db.VarChar(1024)
  role             String    @db.VarChar(16)
  status           String    @db.VarChar(16)
  locked_at        DateTime? @db.Timestamptz(3)
  locked_reason    String?   @db.Text

  created_at DateTime @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  authSessions          AuthSession[]        @relation("AuthSession_user")
  passwordResetTokens   PasswordResetToken[] @relation("PasswordResetToken_user")
  ownerProfile          OwnerProfile?        @relation("OwnerProfile_user")
  ownerRequests         OwnerRequest[]       @relation("OwnerRequest_applicant")
  reviewedOwnerRequests OwnerRequest[]       @relation("OwnerRequest_reviewer")
  reviewedFacilities    Facility[]           @relation("Facility_reviewer")
  bookings              Booking[]            @relation("Booking_customer")
  confirmedBookings     Booking[]            @relation("Booking_confirmer")
  bookingSeries         BookingSeries[]      @relation("BookingSeries_customer")
  confirmedBookingSeries BookingSeries[]     @relation("BookingSeries_confirmer")
  reviewedPaymentProofs PaymentProof[]       @relation("PaymentProof_reviewer")
  courtBlocks           CourtBlock[]         @relation("CourtBlock_creator")
  favorites             Favorite[]           @relation("Favorite_user")
  moderatedReviews      Review[]             @relation("Review_moderator")
  notifications         Notification[]       @relation("Notification_recipient")
  editedContentPages    ContentPage[]        @relation("ContentPage_editor")

  @@index([role, status, created_at])
  @@map("users")
}

model AuthSession {
  id BigInt @id @default(autoincrement()) @db.BigInt

  user_id    BigInt    @db.BigInt
  token_hash Bytes     @unique @db.ByteA
  csrf_token String    @db.Char(64)
  expires_at DateTime  @db.Timestamptz(3)
  revoked_at DateTime? @db.Timestamptz(3)

  created_at DateTime @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  user User @relation("AuthSession_user", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([user_id, revoked_at])
  @@index([expires_at])
  @@map("auth_sessions")
}

/// Chỉ lưu hash. TTL 15 phút và tiêu thụ token nguyên tử thuộc application/transaction; không default TTL.
model PasswordResetToken {
  id BigInt @id @default(autoincrement()) @db.BigInt

  user_id        BigInt    @db.BigInt
  token_hash     Bytes     @unique @db.ByteA
  expires_at     DateTime  @db.Timestamptz(3)
  used_at        DateTime? @db.Timestamptz(3)
  invalidated_at DateTime? @db.Timestamptz(3)

  created_at DateTime @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  user User @relation("PasswordResetToken_user", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([user_id, used_at, invalidated_at])
  @@index([expires_at])
  @@map("password_reset_tokens")
}

/// Owner approval riêng với Facility approval; approved_request phải thuộc cùng user và đã APPROVED trong transaction.
model OwnerProfile {
  user_id             BigInt   @id @db.BigInt
  approved_request_id BigInt   @unique @db.BigInt
  created_at          DateTime @db.Timestamptz(3)
  updated_at          DateTime @updatedAt @db.Timestamptz(3)

  user            User         @relation("OwnerProfile_user", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedRequest OwnerRequest @relation("OwnerProfile_approvedRequest", fields: [approved_request_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  facilities      Facility[]   @relation("Facility_owner")

  @@map("owner_profiles")
}

/// PENDING/APPROVED/REJECTED; partial unique không cấm nhiều request REJECTED lịch sử.
model OwnerRequest {
  id BigInt @id @default(autoincrement()) @db.BigInt

  user_id                  BigInt    @db.BigInt
  status                   String    @db.VarChar(16)
  applicant_name_snapshot  String    @db.VarChar(150)
  applicant_email_snapshot String    @db.VarChar(254)
  applicant_phone_snapshot String?   @db.VarChar(30)
  reviewed_by              BigInt?   @db.BigInt
  reviewed_at              DateTime? @db.Timestamptz(3)
  rejection_reason         String?   @db.Text

  created_at DateTime @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  approvedProfile OwnerProfile?  @relation("OwnerProfile_approvedRequest")
  applicant       User           @relation("OwnerRequest_applicant", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewer        User?          @relation("OwnerRequest_reviewer", fields: [reviewed_by], references: [id], onDelete: Restrict, onUpdate: Restrict)
  notifications   Notification[] @relation("Notification_ownerRequest")

  @@unique([user_id], map: "owner_requests_one_pending_per_user", where: raw("status = 'PENDING'"))
  @@index([status, created_at])
  @@index([user_id, created_at])
  @@map("owner_requests")
}

/// DRAFT/PENDING/ACTIVE/REJECTED/SUSPENDED. Giờ TIME không timezone; thời điểm xét theo Asia/Ho_Chi_Minh.
model Facility {
  id BigInt @id @default(autoincrement()) @db.BigInt

  owner_id          BigInt    @db.BigInt
  name              String    @db.VarChar(200)
  address           String    @db.VarChar(500)
  district          String    @db.VarChar(100)
  latitude          Decimal?  @db.Decimal(10, 7)
  longitude         Decimal?  @db.Decimal(10, 7)
  phone             String    @db.VarChar(30)
  description       String?   @db.Text
  opening_time      DateTime  @db.Time(6)
  closing_time      DateTime  @db.Time(6)
  status            String    @db.VarChar(16)
  submitted_at      DateTime? @db.Timestamptz(3)
  reviewed_by       BigInt?   @db.BigInt
  reviewed_at       DateTime? @db.Timestamptz(3)
  rejection_reason  String?   @db.Text
  suspended_at      DateTime? @db.Timestamptz(3)
  suspension_reason String?   @db.Text

  created_at DateTime @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  owner              OwnerProfile        @relation("Facility_owner", fields: [owner_id], references: [user_id], onDelete: Restrict, onUpdate: Restrict)
  reviewer           User?               @relation("Facility_reviewer", fields: [reviewed_by], references: [id], onDelete: Restrict, onUpdate: Restrict)
  images             FacilityImage[]     @relation("FacilityImage_facility")
  courts             Court[]             @relation("Court_facility")
  amenities          FacilityAmenity[]   @relation("FacilityAmenity_facility")
  priceRules         PriceRule[]         @relation("PriceRule_facility")
  cancellationPolicy CancellationPolicy? @relation("CancellationPolicy_facility")
  bankAccount        BankAccount?        @relation("BankAccount_facility")
  favorites          Favorite[]          @relation("Favorite_facility")
  notifications      Notification[]      @relation("Notification_facility")
  bookingSeries      BookingSeries[]      @relation("BookingSeries_facility")

  @@index([owner_id, status])
  @@index([status, district])
  @@index([name])
  @@map("facilities")
}

model FacilityImage {
  id BigInt @id @default(autoincrement()) @db.BigInt

  facility_id BigInt @db.BigInt
  image_path  String @db.VarChar(1024)
  sort_order  Int    @db.Integer

  created_at DateTime @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  facility Facility @relation("FacilityImage_facility", fields: [facility_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([facility_id, sort_order])
  @@map("facility_images")
}

/// ACTIVE/INACTIVE; không xóa sân có lịch sử.
model Court {
  id BigInt @id @default(autoincrement()) @db.BigInt

  facility_id BigInt  @db.BigInt
  name        String  @db.VarChar(100)
  description String? @db.Text
  status      String  @db.VarChar(16)

  created_at DateTime @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  facility  Facility        @relation("Court_facility", fields: [facility_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bookings  Booking[]       @relation("Booking_court")
  slotLocks CourtSlotLock[] @relation("CourtSlotLock_court")
  blocks    CourtBlock[]    @relation("CourtBlock_court")
  bookingSeries BookingSeries[] @relation("BookingSeries_court")

  @@unique([facility_id, name])
  @@index([facility_id, status])
  @@map("courts")
}

model Amenity {
  id BigInt @id @default(autoincrement()) @db.BigInt

  name      String  @unique @db.VarChar(100)
  is_active Boolean @db.Boolean

  created_at DateTime @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  facilities FacilityAmenity[] @relation("FacilityAmenity_amenity")

  @@map("amenities")
}

model FacilityAmenity {
  facility_id BigInt   @db.BigInt
  amenity_id  BigInt   @db.BigInt
  created_at  DateTime @db.Timestamptz(3)
  updated_at  DateTime @updatedAt @db.Timestamptz(3)

  facility Facility @relation("FacilityAmenity_facility", fields: [facility_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  amenity  Amenity  @relation("FacilityAmenity_amenity", fields: [amenity_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([facility_id, amenity_id])
  @@index([amenity_id, facility_id])
  @@map("facility_amenities")
}

/// Không overlap: service khóa Facility. UNIQUE không tự bảo vệ overlap; không thêm exclusion constraint ngoài thiết kế.
model PriceRule {
  id BigInt @id @default(autoincrement()) @db.BigInt

  facility_id BigInt   @db.BigInt
  start_time  DateTime @db.Time(6)
  end_time    DateTime @db.Time(6)
  hourly_rate Decimal  @db.Decimal(12, 0)

  created_at DateTime @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  facility Facility @relation("PriceRule_facility", fields: [facility_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([facility_id, start_time, end_time])
  @@index([facility_id, start_time])
  @@map("price_rules")
}

/// Không đặt cutoff mặc định; snapshot nullable của Booking giữ nguyên semantics tài liệu.
model CancellationPolicy {
  id BigInt @id @default(autoincrement()) @db.BigInt

  facility_id  BigInt @unique @db.BigInt
  cutoff_hours Int    @db.Integer

  created_at DateTime @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  facility Facility @relation("CancellationPolicy_facility", fields: [facility_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("cancellation_policies")
}

model BankAccount {
  id BigInt @id @default(autoincrement()) @db.BigInt

  facility_id    BigInt  @unique @db.BigInt
  bank_name      String  @db.VarChar(150)
  account_number String  @db.VarChar(50)
  account_holder String  @db.VarChar(150)
  qr_image_path  String? @db.VarChar(1024)

  created_at DateTime @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  facility Facility @relation("BankAccount_facility", fields: [facility_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("bank_accounts")
}

/// PENDING_PAYMENT/PENDING_CONFIRMATION/CONFIRMED/COMPLETED/CANCELLED/REJECTED/EXPIRED.
/// PENDING_CONFIRMATION không expire/cancel; REFUNDED không thuộc Booking. Tiền snapshot do backend tính, không default 30%.
model Booking {
  id BigInt @id @default(autoincrement()) @db.BigInt

  customer_id                        BigInt    @db.BigInt
  court_id                           BigInt    @db.BigInt
  booking_series_id                  BigInt?   @db.BigInt
  status                             String    @db.VarChar(32)
  booking_flow_version               Int       @default(1) @db.SmallInt
  start_at                           DateTime  @db.Timestamptz(3)
  end_at                             DateTime  @db.Timestamptz(3)
  expires_at                         DateTime  @db.Timestamptz(3)
  confirmation_expires_at            DateTime? @db.Timestamptz(3)
  total_amount                       Decimal   @db.Decimal(12, 0)
  deposit_amount                     Decimal   @db.Decimal(12, 0)
  remaining_amount                   Decimal   @db.Decimal(12, 0)
  cancellation_cutoff_hours_snapshot Int?      @db.Integer
  bank_name_snapshot                 String    @db.VarChar(150)
  account_number_snapshot            String    @db.VarChar(50)
  account_holder_snapshot            String    @db.VarChar(150)
  qr_image_path_snapshot             String?   @db.VarChar(1024)
  facility_name_snapshot             String    @db.VarChar(200)
  facility_address_snapshot          String    @db.VarChar(500)
  court_name_snapshot                String    @db.VarChar(100)
  confirmed_at                       DateTime? @db.Timestamptz(3)
  confirmed_by_user_id               BigInt?   @db.BigInt
  completed_at                       DateTime? @db.Timestamptz(3)
  cancelled_at                       DateTime? @db.Timestamptz(3)
  rejected_at                        DateTime? @db.Timestamptz(3)
  expired_at                         DateTime? @db.Timestamptz(3)
  cancelled_by                       String?   @db.VarChar(16)
  rejection_reason                   String?   @db.Text
  cancellation_reason                String?   @db.Text

  created_at DateTime @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  customer      User           @relation("Booking_customer", fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  confirmer     User?          @relation("Booking_confirmer", fields: [confirmed_by_user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  court         Court          @relation("Booking_court", fields: [court_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bookingSeries BookingSeries? @relation("BookingSeries_bookings", fields: [booking_series_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  slots         BookingSlot[]  @relation("BookingSlot_booking")
  paymentProof  PaymentProof?  @relation("PaymentProof_booking")
  refund        Refund?        @relation("Refund_booking")
  review        Review?        @relation("Review_booking")
  notifications Notification[] @relation("Notification_booking")

  @@index([customer_id, created_at])
  @@index([court_id, start_at, end_at])
  @@index([status, expires_at])
  @@index([status, start_at])
  @@unique([booking_series_id, start_at])
  @@map("bookings")
}

/// Nền tảng additive cho lịch cố định. Phase 2 chỉ tạo schema và read-only search; chưa tạo series runtime.
model BookingSeries {
  id BigInt @id @default(autoincrement()) @db.BigInt

  customer_id             BigInt   @db.BigInt
  facility_id             BigInt   @db.BigInt
  court_id                BigInt   @db.BigInt
  weekday                 Int      @db.SmallInt
  start_time              DateTime @db.Time(6)
  end_time                DateTime @db.Time(6)
  starts_on               DateTime @db.Date
  ends_on                 DateTime @db.Date
  occurrence_count        Int      @db.SmallInt
  status                  String   @db.VarChar(32)
  confirmation_expires_at DateTime @db.Timestamptz(3)

  total_amount     Decimal @db.Decimal(12, 0)
  deposit_amount   Decimal @db.Decimal(12, 0)
  remaining_amount Decimal @db.Decimal(12, 0)

  bank_name_snapshot         String  @db.VarChar(150)
  account_number_snapshot    String  @db.VarChar(50)
  account_holder_snapshot    String  @db.VarChar(150)
  qr_image_path_snapshot     String? @db.VarChar(1024)
  facility_name_snapshot     String  @db.VarChar(200)
  facility_address_snapshot  String  @db.VarChar(500)
  court_name_snapshot        String  @db.VarChar(100)

  confirmed_at         DateTime? @db.Timestamptz(3)
  confirmed_by_user_id BigInt?   @db.BigInt
  rejected_at          DateTime? @db.Timestamptz(3)
  rejection_reason     String?   @db.Text
  created_at           DateTime  @db.Timestamptz(3)
  updated_at           DateTime  @updatedAt @db.Timestamptz(3)

  customer User      @relation("BookingSeries_customer", fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  confirmer User?    @relation("BookingSeries_confirmer", fields: [confirmed_by_user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  facility  Facility  @relation("BookingSeries_facility", fields: [facility_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  court     Court     @relation("BookingSeries_court", fields: [court_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bookings  Booking[] @relation("BookingSeries_bookings")

  @@index([customer_id, created_at])
  @@index([facility_id, status, created_at])
  @@index([court_id, starts_on, ends_on])
  @@map("booking_series")
}

/// Lịch sử slot 30 phút, không UNIQUE Court/thời điểm ở bảng lịch sử.
model BookingSlot {
  id BigInt @id @default(autoincrement()) @db.BigInt

  booking_id           BigInt   @db.BigInt
  start_at             DateTime @db.Timestamptz(3)
  end_at               DateTime @db.Timestamptz(3)
  hourly_rate_snapshot Decimal  @db.Decimal(12, 0)
  slot_amount          Decimal  @db.Decimal(14, 2)

  created_at DateTime @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  booking Booking        @relation("BookingSlot_booking", fields: [booking_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lock    CourtSlotLock? @relation("CourtSlotLock_bookingSlot")

  @@unique([booking_id, start_at])
  @@index([booking_id, end_at])
  @@map("booking_slots")
}

/// PK bảo vệ một Court + start_at. Service phải kiểm tra khớp BookingSlot/Booking và cấp/nhả khóa trong transaction.
model CourtSlotLock {
  court_id        BigInt   @db.BigInt
  start_at        DateTime @db.Timestamptz(3)
  booking_slot_id BigInt   @unique @db.BigInt
  created_at      DateTime @db.Timestamptz(3)
  updated_at      DateTime @updatedAt @db.Timestamptz(3)

  court       Court       @relation("CourtSlotLock_court", fields: [court_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bookingSlot BookingSlot @relation("CourtSlotLock_bookingSlot", fields: [booking_slot_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([court_id, start_at])
  @@map("court_slot_locks")
}

/// SUBMITTED/APPROVED/REJECTED; một proof cọc/booking, không resubmit trên booking cũ, không dùng cho refund/70%.
model PaymentProof {
  id BigInt @id @default(autoincrement()) @db.BigInt

  booking_id       BigInt    @unique @db.BigInt
  image_path       String    @db.VarChar(1024)
  mime_type        String    @db.VarChar(100)
  size_bytes       BigInt    @db.BigInt
  status           String    @db.VarChar(16)
  submitted_at     DateTime  @db.Timestamptz(3)
  reviewed_by      BigInt?   @db.BigInt
  reviewed_at      DateTime? @db.Timestamptz(3)
  rejection_reason String?   @db.Text

  created_at DateTime @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  booking  Booking @relation("PaymentProof_booking", fields: [booking_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewer User?   @relation("PaymentProof_reviewer", fields: [reviewed_by], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, submitted_at])
  @@map("payment_proofs")
}

/// PENDING/PROOF_SUBMITTED/REFUNDED; proof hoàn tiền trong Refund, không có bảng RefundProof riêng.
/// CHECK theo trạng thái ở migration sau; amount = deposit đã APPROVED do service kiểm tra liên bảng.
model Refund {
  id BigInt @id @default(autoincrement()) @db.BigInt

  booking_id         BigInt    @unique @db.BigInt
  amount             Decimal   @db.Decimal(12, 0)
  status             String    @db.VarChar(32)
  reason             String    @db.Text
  proof_image_path   String?   @db.VarChar(1024)
  proof_mime_type    String?   @db.VarChar(100)
  proof_size_bytes   BigInt?   @db.BigInt
  requested_at       DateTime  @db.Timestamptz(3)
  proof_submitted_at DateTime? @db.Timestamptz(3)
  refunded_at        DateTime? @db.Timestamptz(3)
  confirmed_at       DateTime? @db.Timestamptz(3)

  created_at DateTime @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  booking Booking @relation("Refund_booking", fields: [booking_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, requested_at])
  @@map("refunds")
}

model CourtBlock {
  id BigInt @id @default(autoincrement()) @db.BigInt

  court_id   BigInt   @db.BigInt
  start_at   DateTime @db.Timestamptz(3)
  end_at     DateTime @db.Timestamptz(3)
  reason     String   @db.Text
  created_by BigInt   @db.BigInt

  created_at DateTime @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  court   Court @relation("CourtBlock_court", fields: [court_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator User  @relation("CourtBlock_creator", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([court_id, start_at, end_at])
  @@map("court_blocks")
}

model Favorite {
  user_id     BigInt   @db.BigInt
  facility_id BigInt   @db.BigInt
  created_at  DateTime @db.Timestamptz(3)
  updated_at  DateTime @updatedAt @db.Timestamptz(3)

  user     User     @relation("Favorite_user", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  facility Facility @relation("Favorite_facility", fields: [facility_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([user_id, facility_id])
  @@index([facility_id, user_id])
  @@map("favorites")
}

/// VISIBLE/HIDDEN; tác giả Customer và Facility suy ra qua Booking, không thêm author_id/facility_id.
model Review {
  id BigInt @id @default(autoincrement()) @db.BigInt

  booking_id        BigInt    @unique @db.BigInt
  rating            Int       @db.SmallInt
  comment           String?   @db.Text
  status            String    @db.VarChar(16)
  moderated_by      BigInt?   @db.BigInt
  moderated_at      DateTime? @db.Timestamptz(3)
  moderation_reason String?   @db.Text

  created_at DateTime @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  booking       Booking        @relation("Review_booking", fields: [booking_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  moderator     User?          @relation("Review_moderator", fields: [moderated_by], references: [id], onDelete: Restrict, onUpdate: Restrict)
  images        ReviewImage[]  @relation("ReviewImage_review")
  notifications Notification[] @relation("Notification_review")

  @@index([status, created_at])
  @@map("reviews")
}

model ReviewImage {
  id BigInt @id @default(autoincrement()) @db.BigInt

  review_id  BigInt @db.BigInt
  image_path String @db.VarChar(1024)
  sort_order Int    @db.Integer

  created_at DateTime @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  review Review @relation("ReviewImage_review", fields: [review_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([review_id, sort_order])
  @@map("review_images")
}

model Notification {
  id BigInt @id @default(autoincrement()) @db.BigInt

  recipient_id     BigInt    @db.BigInt
  event_type       String    @db.VarChar(64)
  event_key        String    @db.VarChar(191)
  title            String    @db.VarChar(200)
  message          String    @db.Text
  booking_id       BigInt?   @db.BigInt
  facility_id      BigInt?   @db.BigInt
  owner_request_id BigInt?   @db.BigInt
  review_id        BigInt?   @db.BigInt
  read_at          DateTime? @db.Timestamptz(3)

  created_at DateTime @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  recipient    User          @relation("Notification_recipient", fields: [recipient_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  booking      Booking?      @relation("Notification_booking", fields: [booking_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  facility     Facility?     @relation("Notification_facility", fields: [facility_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownerRequest OwnerRequest? @relation("Notification_ownerRequest", fields: [owner_request_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  review       Review?       @relation("Notification_review", fields: [review_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([recipient_id, event_key])
  @@index([recipient_id, read_at, created_at])
  @@map("notifications")
}

/// Chỉ ánh xạ các cột dự kiến đã định nghĩa; TODO loại nội dung/format body, API vẫn reserved.
model ContentPage {
  id BigInt @id @default(autoincrement()) @db.BigInt

  slug         String  @unique @db.VarChar(150)
  title        String  @db.VarChar(200)
  body         String  @db.Text
  is_published Boolean @db.Boolean
  updated_by   BigInt  @db.BigInt

  created_at DateTime @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  editor User @relation("ContentPage_editor", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([is_published, slug])
  @@map("content_pages")
}
